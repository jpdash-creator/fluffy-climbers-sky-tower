<Project Sdk="Microsoft.NET.Sdk">

  <!-- Computer test (headless): climbs Endless and Time Attack towers with the LevelBot over many seeds, driven tick by tick like RunSession (EndlessWorld.Grow after every step). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../Assets/_Game/Simulation/**/*.cs" />
    <Compile Include="../../Assets/_Game/Economy/HeroTable.cs" />
    <Compile Include="../../Assets/_Game/Economy/HeroVariants.cs" />
    <Compile Include="../../Assets/_Game/Economy/HeroRolls.cs" />
    <Compile Include="../../Assets/_Game/Economy/TierRules.cs" />
    <Compile Include="../../Assets/_Game/Economy/HeroRegionPenalty.cs" />
    <Compile Include="../../Assets/_Game/Economy/MergeTierDefs.cs" />
    <Compile Include="../../Assets/_Game/Economy/Characters.cs" />
    <Compile Include="../Simulation/ContentLoader.cs" />
  </ItemGroup>

</Project>
